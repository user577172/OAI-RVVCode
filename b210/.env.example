# K3 native OAI + USRP B210 launcher settings.
# Copy to b210/.env, then replace the placeholder values.

USRP_SERIAL=REPLACE_WITH_UHD_SERIAL
AMF_IP=REPLACE_WITH_AMF_IPV4

# Optional. Leave empty to let the launcher select the K3 source address
# from the route to AMF_IP.
GNB_IP=

# Optional. If omitted, the launcher uses this OAI repository's own build.
# K3_GNB_BUILD=/absolute/path/to/openairinterface5g/cmake_targets/ran_build/build

# X100 scalar/RVV cores. Do not select A100 cores here for the normal gNB.
K3_GNB_ALLOWED_CPUS=0-6
K3_GNB_THREAD_POOL=3,4,5,6

# Keep disabled during normal UE registration. Enable only for RF diagnostics.
K3_GNB_CONTINUOUS_TX=0

GNB_EXTRA_OPTIONS="--L1s.[0].L1_rx_thread_core 0 --L1s.[0].L1_tx_thread_core 1 --RUs.[0].ru_thread_core 2 --usrp-tx-thread-config 1 --gNBs.[0].min_rxtxtime 8 -q"
